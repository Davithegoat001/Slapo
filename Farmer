local graficosBaixos = false
local propriedadesOriginais = {}
local conexaoDescendant

local sombrasOriginais = Lighting.GlobalShadows
local nevoaOriginal = Lighting.FogEnd

local function guardarPropriedade(objeto, propriedade)

    if not propriedadesOriginais[objeto] then
        propriedadesOriginais[objeto] = {}
    end

    if propriedadesOriginais[objeto][propriedade] == nil then

        local sucesso, valor = pcall(function()
            return objeto[propriedade]
        end)

        if sucesso then
            propriedadesOriginais[objeto][propriedade] = valor
        end

    end

end

local function aplicarGraficosBaixos(objeto)

    if objeto:IsA("ParticleEmitter")
    or objeto:IsA("Trail")
    or objeto:IsA("Beam")
    or objeto:IsA("Fire")
    or objeto:IsA("Smoke")
    or objeto:IsA("Sparkles") then

        guardarPropriedade(objeto, "Enabled")

        pcall(function()
            objeto.Enabled = false
        end)

    end

    if objeto:IsA("BasePart") then

        guardarPropriedade(objeto, "Material")
        guardarPropriedade(objeto, "CastShadow")

        pcall(function()
            objeto.Material = Enum.Material.SmoothPlastic
            objeto.CastShadow = false
        end)

    end

    if objeto:IsA("Decal") or objeto:IsA("Texture") then

        guardarPropriedade(objeto, "Transparency")

        pcall(function()
            objeto.Transparency = 1
        end)

    end

end

local function restaurarGraficos()

    for objeto, propriedades in pairs(propriedadesOriginais) do

        if objeto and objeto.Parent then

            for propriedade, valor in pairs(propriedades) do

                pcall(function()
                    objeto[propriedade] = valor
                end)

            end

        end

    end

    propriedadesOriginais = {}

    pcall(function()
        Lighting.GlobalShadows = sombrasOriginais
        Lighting.FogEnd = nevoaOriginal
    end)

end

local function ativarGraficosBaixos()

    for _, objeto in ipairs(game:GetDescendants()) do
        aplicarGraficosBaixos(objeto)
    end

    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100000

    if conexaoDescendant then
        conexaoDescendant:Disconnect()
    end

    conexaoDescendant = game.DescendantAdded:Connect(function(objeto)

        if graficosBaixos then
            aplicarGraficosBaixos(objeto)
        end

    end)

end

Tabs.Desempenho:AddToggle("GraficosBaixos", {
    Title = "Gráficos baixos",
    Description = "Reduz efeitos visuais para melhorar o desempenho.",
    Default = false
})

Options.GraficosBaixos:OnChanged(function()

    graficosBaixos = Options.GraficosBaixos.Value

    if graficosBaixos then
        ativarGraficosBaixos()
    else

        if conexaoDescendant then
            conexaoDescendant:Disconnect()
            conexaoDescendant = nil
        end

        restaurarGraficos()

    end

end)

