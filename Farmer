local quantidades = {
    "100",
    "1000",
    "1M",
    "10T",
    "1Q",
    "100Q",
    "Personalizado"
}

local multiplicadores = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
    Q = 1e15
}

local quantidadeRebirth = "100"
local quantidadeRebirthPersonalizada = "100"

local function converterQuantidade(valor)
    valor = tostring(valor):upper()
    valor = valor:gsub("%s+", "")
    valor = valor:gsub(",", ".")

    local numero, sufixo = valor:match("^([%d%.]+)([KMBTQ]?)$")

    if not numero then
        return 0
    end

    numero = tonumber(numero)

    if not numero then
        return 0
    end

    return numero * (multiplicadores[sufixo] or 1)
end

