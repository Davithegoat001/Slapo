local graficosBaixos = false
local propriedadesOriginais = {}

local function salvarPropriedade(objeto, propriedade, valor)
    if propriedadesOriginais[objeto] == nil then
        propriedadesOriginais[objeto] = {}
    end

    if propriedadesOriginais[objeto][propriedade] == nil then
        pcall(function()
            propriedadesOriginais[objeto][propriedade] =
                objeto[propriedade]
        end)
    end

    pcall(function()
        objeto[propriedade] = valor
    end)
end

local function aplicarGraficosBaixos(objeto)
    if objeto:IsA("ParticleEmitter")
    or objeto:IsA("Trail")
    or objeto:IsA("Beam")
    or objeto:IsA("Fire")
    or objeto:IsA("Smoke")
    or objeto:IsA("Sparkles") then

        salvarPropriedade(objeto, "Enabled", false)

    elseif objeto:IsA("BasePart") then

        salvarPropriedade(objeto, "Material", Enum.Material.SmoothPlastic)
        salvarPropriedade(objeto, "CastShadow", false)

    elseif objeto:IsA("Decal") or objeto:IsA("Texture") then

        salvarPropriedade(objeto, "Transparency", 1)
    end
end

local function ativarGraficosBaixos()
    salvarPropriedade(Lighting, "GlobalShadows", false)
    salvarPropriedade(Lighting, "FogEnd", 100000)

    for _, objeto in ipairs(game:GetDescendants()) do
        aplicarGraficosBaixos(objeto)
    end
end

game.DescendantAdded:Connect(function(objeto)
    if graficosBaixos then
        task.wait()
        aplicarGraficosBaixos(objeto)
    end
end)

Tabs.Desempenho:AddToggle("GraficosBaixos", {
    Title = "Gráficos baixos",
    Description = "Reduz efeitos visuais para melhorar o desempenho.",
    Default = false,

    Callback = function(Value)
        graficosBaixos = Value

        if Value then
            ativarGraficosBaixos()
        end
    end
})

Tabs.Desempenho:AddToggle("ModoAFK", {
