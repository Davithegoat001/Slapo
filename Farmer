--==================================================
-- REFERÊNCIAS DO EVENTO
--==================================================

local function encontrarAutumnEvent()
    return workspace:FindFirstChild("Autumn Event")
end

local function encontrarMacas()
    local pasta = workspace:FindFirstChild("AutumnApples")

    if pasta then
        return pasta
    end

    local evento = encontrarAutumnEvent()

    if evento then
        return evento:FindFirstChild("AutumnApples", true)
    end

    return nil
end

