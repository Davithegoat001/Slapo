--==================================================
-- UPGRADE AUTOMÁTICO
--==================================================

local upgradeAtivado = false
local upgradeRunId = 0

local function iniciarUpgrade()

    upgradeRunId += 1

    local meuRun = upgradeRunId

    task.spawn(function()

        while upgradeAtivado and meuRun == upgradeRunId do

            local escolhido = upgradesMacas[
                math.random(1, #upgradesMacas)
            ]

            local sucesso, erro = pcall(function()

                BuyUpgrade:InvokeServer(escolhido[1], true)

            end)

            if not sucesso then
                warn("Erro no upgrade:", erro)
            end

            task.wait(INTERVALO_UPGRADE)

        end

    end)

end

