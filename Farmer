local dragging = false
local foiArrastado = false
local inputInicial = nil
local posicaoInicial = nil
local inicioToque = nil

local function atualizarIcone()
    BotaoAbrir.Visible = Window.Minimized
end

BotaoAbrir.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        foiArrastado = false
        inputInicial = input
        inicioToque = input.Position
        posicaoInicial = BotaoAbrir.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    local movimentoValido =
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch

    if not movimentoValido then
        return
    end

    local delta = input.Position - inicioToque

    if delta.Magnitude > 5 then
        foiArrastado = true
    end

    if foiArrastado then
        local novaX = posicaoInicial.X.Offset + delta.X
        local novaY = posicaoInicial.Y.Offset + delta.Y

        local camera = workspace.CurrentCamera
        local tamanhoTela = camera.ViewportSize
        local tamanhoBotao = BotaoAbrir.AbsoluteSize

        novaX = math.clamp(
            novaX,
            0,
            tamanhoTela.X - tamanhoBotao.X
        )

        novaY = math.clamp(
            novaY,
            0,
            tamanhoTela.Y - tamanhoBotao.Y
        )

        BotaoAbrir.Position = UDim2.fromOffset(novaX, novaY)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    local terminouToque =
        input.UserInputType == Enum.UserInputType.Touch
        and input == inputInicial

    local terminouMouse =
        input.UserInputType == Enum.UserInputType.MouseButton1

    if not dragging or not (terminouToque or terminouMouse) then
        return
    end

    dragging = false

    if not foiArrastado and Window.Minimized then
        Window:Minimize()
    end

    atualizarIcone()

    inputInicial = nil
    inicioToque = nil
    posicaoInicial = nil
end)

task.spawn(function()
    while ScreenGui.Parent do
        atualizarIcone()
        task.wait(0.1)
    end
end)
