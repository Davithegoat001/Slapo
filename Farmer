            end)
        end
    end
})

--==================================================
-- DESEMPENHO
--==================================================

local graficosBaixos = false
local modoAFK = false
local propriedadesOriginais = {}

local function salvarPropriedade(objeto, propriedade)
    if not propriedadesOriginais[objeto] then
        propriedadesOriginais[objeto] = {}
    end

    if propriedadesOriginais[objeto][propriedade] == nil then
        pcall(function()
            propriedadesOriginais[objeto][propriedade] =
                objeto[propriedade]
        end)
    end
end

local function alterarEfeito(objeto)
    if objeto:IsA("ParticleEmitter")
        or objeto:IsA("Trail")
        or objeto:IsA("Beam")
        or objeto:IsA("Fire")
        or objeto:IsA("Smoke")
        or objeto:IsA("Sparkles") then

        salvarPropriedade(objeto, "Enabled")

        pcall(function()
            objeto.Enabled = false
        end)
    end

    if objeto:IsA("PostEffect") then
        salvarPropriedade(objeto, "Enabled")

        pcall(function()
            objeto.Enabled = false
        end)
    end
end

local function aplicarGraficos()
    if not graficosBaixos and not modoAFK then
        return
    end

    pcall(function()
        Lighting.GlobalShadows = false
        workspace.Terrain.Decoration = false
    end)

    for _, objeto in ipairs(workspace:GetDescendants()) do
        alterarEfeito(objeto)
    end

    for _, objeto in ipairs(Lighting:GetDescendants()) do
        alterarEfeito(objeto)
    end
end

local function restaurarGraficos()
    for objeto, propriedades in pairs(propriedadesOriginais) do
        for propriedade, valor in pairs(propriedades) do
            pcall(function()
                objeto[propriedade] = valor
            end)
        end
    end

    table.clear(propriedadesOriginais)

    pcall(function()
        Lighting.GlobalShadows = true
        workspace.Terrain.Decoration = true
    end)
end

Tabs.Performance:AddToggle("LowGraphics", {
    Title = "Gráficos baixos",
    Default = false,

    Callback = function(Value)
        graficosBaixos = Value

        if Value then
            aplicarGraficos()
        elseif not modoAFK then
            restaurarGraficos()
        end
    end
})

Tabs.Performance:AddToggle("AFKMode", {
    Title = "Modo AFK de baixo consumo",
    Default = false,

    Callback = function(Value)
        modoAFK = Value

        if Value then
            aplicarGraficos()
        elseif not graficosBaixos then
            restaurarGraficos()
        end
    end
})

Tabs.Performance:AddButton({
    Title = "Restaurar gráficos",

    Callback = function()
        graficosBaixos = false
        modoAFK = false

        restaurarGraficos()

        Fluent:Notify({
            Title = "Desempenho",
            Content = "Configurações visuais restauradas.",
            Duration = 3
        })
    end
})

