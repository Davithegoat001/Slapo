local rebirthAtivado = false
local rebirthRunId = 0

local function iniciarRebirth()

    rebirthRunId += 1
    local meuRun = rebirthRunId

    task.spawn(function()

        while rebirthAtivado and meuRun == rebirthRunId do

            if not Rebirth then
                warn("Remote Rebirth não encontrado.")
                task.wait(3)
                continue
            end

            local atual = obterMacasAtuais()
            local necessario = obterQuantidadeRebirth()

            if atual and necessario and atual >= necessario then

                local sucesso, erro = pcall(function()
                    Rebirth:InvokeServer()
                end)

                if not sucesso then
                    warn("Erro no Auto Rebirth:", erro)
                end

                task.wait(5)

            else
                task.wait(INTERVALO_REBIRTH)
            end

        end

    end)

end

