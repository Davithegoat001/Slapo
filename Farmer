--==================================================
-- DESEMPENHO
--==================================================

local baixoGraficoAtivo = false
local modoAFKAtivo = false

local valoresOriginais = {}

local function alterarPropriedade(objeto, propriedade, valor)
    if not valoresOriginais[objeto] then
        valoresOriginais[objeto] = {}
    end

    if valoresOriginais[objeto][propriedade] == nil then
        local sucesso, original = pcall(function()
            return objeto[propriedade]
        end)

        if not sucesso then
            return
        end

        valoresOriginais[objeto][propriedade] = original
    end

    pcall(function()
        objeto[propriedade] = valor
    end)
end

local function reduzirObjeto(objeto)
    if objeto:IsA("ParticleEmitter") then
        alterarPropriedade(objeto, "Enabled", false)

    elseif objeto:IsA("Trail") or objeto:IsA("Beam") then
        alterarPropriedade(objeto, "Enabled", false)

    elseif objeto:IsA("Fire")
        or objeto:IsA("Smoke")
        or objeto:IsA("Sparkles") then

        alterarPropriedade(objeto, "Enabled", false)

    elseif objeto:IsA("BloomEffect")
        or objeto:IsA("BlurEffect")
        or objeto:IsA("ColorCorrectionEffect")
        or objeto:IsA("DepthOfFieldEffect")
        or objeto:IsA("SunRaysEffect") then

        alterarPropriedade(objeto, "Enabled", false)
    end
end

local function aplicarGraficosBaixos()
    alterarPropriedade(Lighting, "GlobalShadows", false)

    pcall(function()
        alterarPropriedade(workspace.Terrain, "Decoration", false)
    end)

    for _, objeto in ipairs(Lighting:GetDescendants()) do
        reduzirObjeto(objeto)
    end

    for _, objeto in ipairs(workspace:GetDescendants()) do
        reduzirObjeto(objeto)
    end
end

local function restaurarGraficos()
    for objeto, propriedades in pairs(valoresOriginais) do
        for propriedade, valor in pairs(propriedades) do
            pcall(function()
                objeto[propriedade] = valor
            end)
        end
    end

    table.clear(valoresOriginais)
end

local function atualizarDesempenho()
    if baixoGraficoAtivo or modoAFKAtivo then
        aplicarGraficosBaixos()
    else
        restaurarGraficos()
    end
end

Tabs.Performance:AddParagraph({
