--==================================================
-- ENCONTRAR PASTA DAS MAÇÃS
--==================================================

local function encontrarMacas()

    local pasta = workspace:FindFirstChild("AutumnApples")

    if pasta then
        return pasta
    end

    local evento = workspace:FindFirstChild("Autumn Event")

    if evento then
        return evento:FindFirstChild("AutumnApples", true)
    end

    return nil
end

--==================================================
-- FARM DE MAÇÃ
--==================================================

local farmAtivado = false
local farmRunId = 0

local function iniciarFarm()

    farmRunId += 1

    local meuRun = farmRunId

    task.spawn(function()

        local pastaMacas = encontrarMacas()

        -- Aguarda a pasta aparecer.
        while farmAtivado
        and meuRun == farmRunId
        and not pastaMacas do

            task.wait(1)
            pastaMacas = encontrarMacas()

        end

        -- Coleta contínua.
        while farmAtivado and meuRun == farmRunId do

            if not pastaMacas or not pastaMacas.Parent then
                pastaMacas = encontrarMacas()
            end

            if pastaMacas then

                for _, maca in ipairs(pastaMacas:GetChildren()) do

                    if not farmAtivado or meuRun ~= farmRunId then
                        break
                    end

                    if maca:IsA("Model") and maca.Parent then

                        local personagem = Player.Character

                        if personagem and personagem.Parent then

                            pcall(function()

                                personagem:PivotTo(
                                    maca:GetPivot() + Vector3.new(0, 3, 0)
                                )

                            end)

                        end

                        task.wait(INTERVALO_COLETA)

                    end

                end

            else

                task.wait(1)

            end

            task.wait(0.2)

        end

    end)

end

