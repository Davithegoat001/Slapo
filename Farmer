--==================================================
-- LER QUANTIDADE DE MAÇÃS
--==================================================

local function obterMacasAtuais()

    local sucesso, resultado = pcall(function()

        local framework = ReplicatedStorage:WaitForChild("Framework")
        local features = framework:WaitForChild("Features")
        local ui = features:WaitForChild("UI")

        local UIReferences = require(
            ui:WaitForChild("UIReferences")
        )

        local label = UIReferences.HUD.AutumnCurrency.Apples.TextLabel
        local texto = tostring(label.Text):upper()

        texto = texto:gsub("%s", "")
        texto = texto:gsub("[^%d%.,KMBTQ]", "")

        local numero, sufixo = texto:match("([%d%.,]+)([KMBTQ]?)")

        if not numero then
            return nil
        end

        if sufixo ~= "" then
            numero = numero:gsub(",", ".")
        else
            numero = numero:gsub(",", "")
        end

        local valor = tonumber(numero)

        if not valor then
            return nil
        end

        return valor * (multiplicadores[sufixo] or 1)

    end)

    if sucesso then
        return resultado
    end

    warn("Erro ao ler contador de maçãs:", resultado)
    return nil

end

