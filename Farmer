local function obterQuantidadeRebirth()
    if quantidadeRebirth == "Personalizado" then
        return converterQuantidade(quantidadeRebirthPersonalizada)
    end

    return converterQuantidade(quantidadeRebirth)
end

local function obterMacasAtuais()
    local sucesso, resultado = pcall(function()
        local UIReferences = require(
            ReplicatedStorage.Framework.Features.UI.UIReferences
        )

        local label = UIReferences.HUD.AutumnCurrency.Apples.TextLabel
        local texto = label.Text

        texto = texto:gsub("%s+", "")
        texto = texto:gsub("[^%d%.,KMBTQkmbtq]", "")
        texto = texto:upper()

        return converterQuantidade(texto)
    end)

    if sucesso then
        return resultado
    end

    return 0
end

local rebirthAtivado = false
local rebirthRunId = 0

local function iniciarRebirth()
    rebirthRunId += 1

    local meuRun = rebirthRunId

    task.spawn(function()
        while rebirthAtivado and meuRun == rebirthRunId do
            local atual = obterMacasAtuais()
            local necessario = obterQuantidadeRebirth()

            if atual >= necessario and Rebirth then
                pcall(function()
                    Rebirth:InvokeServer()
                end)

                task.wait(5)
            else
                task.wait(INTERVALO_REBIRTH)
            end
        end
    end)
end

