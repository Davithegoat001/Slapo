--==================================================
-- SISTEMA DE VIAGEM E SINCRONIZAÇÃO
--==================================================

local function entrarAutumn()
    local sucesso, erro = pcall(function()
        Travel:InvokeServer("Autumn")
    end)

    if not sucesso then
        warn("Erro ao solicitar entrada em Autumn:", erro)
    end
end

local function sincronizarMacas()
    local sucesso, erro = pcall(function()
        Sync:InvokeServer()
    end)

    if not sucesso then
        warn("Erro ao sincronizar maçãs:", erro)
    end
end

local function iniciarSincronizacao()
    task.spawn(function()

        -- Solicita a entrada na área uma vez
        entrarAutumn()

        -- Aguarda a possível transição
        task.wait(3)

        while farmAtivado do

            sincronizarMacas()

            -- Intervalo entre sincronizações
            task.wait(5)
        end
    end)
end

--==================================================
-- ENCONTRAR MAÇÃS
--==================================================

local function encontrarMacas()

    local pasta = workspace:FindFirstChild("AutumnApples")

    if pasta then
        return pasta
    end

    local evento = workspace:FindFirstChild("Autumn Event")

    if evento then
        return evento:FindFirstChild("AutumnApples", true)
    end

    return nil
end

--==================================================
-- FARM AUTOMÁTICO
--==================================================

local function iniciarFarm()

    task.spawn(function()

        while farmAtivado do

            local pastaMacas = encontrarMacas()

            local personagem = Player.Character

            if pastaMacas and personagem then

                local HumanoidRootPart =
                    personagem:FindFirstChild("HumanoidRootPart")

                if HumanoidRootPart then

                    for _, maca in ipairs(pastaMacas:GetChildren()) do

                        if not farmAtivado then
                            break
                        end

                        if maca:IsA("Model") then

                            pcall(function()
                                personagem:PivotTo(
                                    maca:GetPivot() +
                                    Vector3.new(0, 3, 0)
                                )
                            end)

                            task.wait(0.6)
                        end
                    end

                end
            else
                task.wait(1)
            end

            task.wait(0.1)
        end
    end)
end

--==================================================
-- UPGRADE AUTOMÁTICO ALEATÓRIO
--==================================================

local function iniciarUpgrade()

    task.spawn(function()

        while upgradeAtivado do

            local escolhido =
                upgradesMacas[math.random(1, #upgradesMacas)]

            local sucesso, erro = pcall(function()

                BuyUpgrade:InvokeServer(
                    escolhido[1],
                    true
                )

            end)

            if not sucesso then
                warn("Erro no upgrade:", erro)
            end

            task.wait(0.7)
        end
    end)
end

