end)

local function iniciarUpgrade()
    if upgradeWorker then
        return
    end

    upgradeWorker = true

    task.spawn(function()
        while upgradeAtivado do
            if BuyUpgrade then
                local escolhido = upgradesMacas[
                    math.random(1, #upgradesMacas)
                ]

                pcall(function()
                    BuyUpgrade:InvokeServer(escolhido[1], true)
                end)
            end

            task.wait(0.7)
        end

        upgradeWorker = false
    end)
end

