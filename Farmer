--==================================================
-- FARM: COLETAR
--==================================================

local farmAtivado = false
local farmWorker = false

local function encontrarMacas()
    local pasta = workspace:FindFirstChild("AutumnApples")

    if pasta then
        return pasta
    end

    local evento = workspace:FindFirstChild("Autumn Event")

    if evento then
        return evento:FindFirstChild("AutumnApples", true)
    end

    return nil
end

local function iniciarFarm()
    if farmWorker then
        return
    end

    farmWorker = true

    task.spawn(function()
        while farmAtivado do
            local pasta = encontrarMacas()
            local personagem = player.Character
            local root = personagem and personagem:FindFirstChild("HumanoidRootPart")

            if pasta and root then
                for _, maca in ipairs(pasta:GetChildren()) do
                    if not farmAtivado then
                        break
                    end

                    if maca:IsA("Model") then
                        pcall(function()
                            personagem:PivotTo(
                                maca:GetPivot() + Vector3.new(0, 3, 0)
                            )
                        end)

                        task.wait(0.6)
                    end
                end
            else
                task.wait(1)
            end

            task.wait(0.1)
        end

        farmWorker = false
    end)
end

Tabs.Farm:AddToggle("Coletar", {
    Title = "Coletar",
    Description = "Ativa a coleta automática de maçãs.",
    Default = false,

    Callback = function(Value)
        farmAtivado = Value

        if Value then
            iniciarFarm()
        end
    end
})

