--==================================================
-- FARM DE MAÇÃ
--==================================================

local farmAtivado = false
local farmWorker = false

Tabs.Farm:AddParagraph({
    Title = "Farm de maçã",
    Content = "Só funciona se entrar no portal que leva a ilha."
})

Tabs.Farm:AddToggle("FarmToggle", {
    Title = "Ativar farm de maçã",
    Default = false,

    Callback = function(Value)
        farmAtivado = Value

        if Value and not farmWorker then
            farmWorker = true

            task.spawn(function()
                while farmAtivado do
                    local pastaMacas = encontrarMacas()

                    if not pastaMacas then
                        task.wait(1)
                        continue
                    end

                    local encontrouMaca = false

                    for _, maca in ipairs(pastaMacas:GetChildren()) do
                        if not farmAtivado then
                            break
                        end

                        if maca:IsA("Model") and maca.Parent == pastaMacas then
                            encontrouMaca = true

                            local personagem = player.Character
                                or player.CharacterAdded:Wait()

                            local root = personagem:FindFirstChild("HumanoidRootPart")

                            if root then
                                pcall(function()
                                    root.CFrame = maca:GetPivot()
                                        + Vector3.new(0, 3, 0)
                                end)
                            end

                            task.wait(0.6)
                        end
                    end

                    if not encontrouMaca then
                        task.wait(0.8)
                    end
                end

                farmWorker = false
            end)
        end
    end
})

