local quantidades = {
    "100",
    "1000",
    "1M",
    "10T",
    "1Q",
    "100Q",
    "Personalizado"
}

local multiplicadores = {
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
    Q = 1e15
}

local function converterQuantidade(valor)

    if valor == nil then
        return nil
    end

    local texto = tostring(valor):upper()
    texto = texto:gsub("%s", "")
    texto = texto:gsub(",", ".")

    local numero, sufixo = texto:match("^([%d%.]+)([KMBTQ]?)$")

    if not numero then
        return nil
    end

    numero = tonumber(numero)

    if not numero or numero <= 0 then
        return nil
    end

    return numero * (multiplicadores[sufixo] or 1)

end

