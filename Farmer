local farmAtivado = false
local farmRunId = 0

local function iniciarFarm()
    farmRunId += 1

    local meuRun = farmRunId

    task.spawn(function()
        while farmAtivado and meuRun == farmRunId do
            local pasta = encontrarMacas()
            local personagem = Player.Character

            if pasta and personagem then
                for _, maca in ipairs(pasta:GetChildren()) do
                    if not farmAtivado or meuRun ~= farmRunId then
                        break
                    end

                    personagem = Player.Character

                    if maca:IsA("Model") and maca.Parent and personagem then
                        personagem:PivotTo(
                            maca:GetPivot() + Vector3.new(0, 3, 0)
                        )

                        task.wait(INTERVALO_COLETA)
                    end
                end
            end

            task.wait(0.1)
        end
    end)
end

